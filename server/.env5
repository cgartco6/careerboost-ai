# Server Configuration
NODE_ENV=production
PORT=3000
BASE_URL=https://yourdomain.co.za

# Database
MONGODB_URI=mongodb://localhost:27017/careerboost

# JWT Secret
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production

# Payment Configuration - UPDATE THESE WITH YOUR REAL DETAILS
FNB_ACCOUNT_NUMBER=your_actual_fnb_account_number
PAYFAST_MERCHANT_ID=your_actual_merchant_id
PAYFAST_MERCHANT_KEY=your_actual_merchant_key
PAYFAST_PASSPHRASE=your_actual_passphrase
PAYFAST_MODE=test

# Email Configuration
EMAIL_HOST=mail.kelnic.co.za
EMAIL_PORT=587
EMAIL_USER=info@kelnic.co.za
EMAIL_PASS=your_email_password

# AI Configuration
OPENAI_API_KEY=your_openai_api_key

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Compliance
POPIA_COMPLIANT=true
BCEA_COMPLIANT=true
